# scripts/build-index.mjs (임베딩 생성) 와 wrangler deploy (배포) 가 함께 사용합니다.
# cp .env.local.example .env.local  후 두 값을 채우세요. (.env.local 은 커밋되지 않습니다)
#
# 토큰 발급: https://dash.cloudflare.com/profile/api-tokens
#   → Create Token → Create Custom Token
#   → Permissions (두 줄 모두 필요):
#       Account · Workers AI      · Read   ← 임베딩 생성
#       Account · Workers Scripts · Edit   ← Worker 배포
#   → Account Resources: Include · 본인 계정
CLOUDFLARE_API_TOKEN=

# 대시보드 → Workers & Pages 페이지 우측의 Account ID (hex 32자)
CLOUDFLARE_ACCOUNT_ID=
